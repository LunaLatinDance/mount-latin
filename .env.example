# Resend API Key - Get it from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Email where contact form messages will be sent
CONTACT_EMAIL=mountlatindance@gmail.com

# Cloudflare Turnstile - Get keys from https://dash.cloudflare.com/?to=/:account/turnstile
# Server-side secret (NEVER expose to the browser)
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxx
# Client-side site key (safe to expose, referenced via VITE_ prefix)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxx
